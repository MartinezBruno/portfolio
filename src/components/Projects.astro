---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { projects } from '../data/projects';
import SectionHeader from './SectionHeader.astro';
import ProjectCard from './ProjectCard.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<section id="projects" class="projects">
  <SectionHeader index="02" title={t('projects.title')} />

  <div class="projects-grid" data-projects-grid>
    {projects.map((project) => <ProjectCard project={project} lang={lang} />)}
  </div>
</section>

<style>
  .projects {
    max-width: 1200px;
    margin: 0 auto;
    padding: 110px 24px 0;
  }
  /* Columns fit the sheet: three on the full 1200px sheet, two on tablets,
     one on phones. Not tied to the project count. */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(270px, 100%), 1fr));
    gap: 28px;
  }
</style>
