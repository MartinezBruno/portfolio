---
import type { Lang } from '../i18n/ui';
import { useTranslations, homePath } from '../i18n/utils';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const links = [
  { href: '#about', n: '01', label: t('nav.about') },
  { href: '#projects', n: '02', label: t('nav.projects') },
  { href: '#contact', n: '03', label: t('nav.contact') },
];
---
<div class="scrim" data-menu-scrim></div>

<aside id="mobile-drawer" class="drawer" data-drawer aria-hidden="true" inert aria-label={t('nav.menu')}>
  <div class="drawer-head">
    <span class="kicker">{t('nav.menu')}</span>
    <button type="button" class="close" data-menu-close aria-label={t('nav.closeMenu')}>
      <Icon name="x" size={18} />
    </button>
  </div>

  <nav class="drawer-nav">
    {links.map((l) => (
      <a href={l.href} class="drawer-link">
        <span class="idx">{l.n}</span>{l.label}
      </a>
    ))}
  </nav>

  <div class="drawer-foot">
    <span class="kicker">{t('nav.language')}</span>
    <div class="lang-box" role="group" aria-label={t('nav.language')}>
      <a href={homePath('en')} hreflang="en" lang="en" class:list={['lang-opt', { active: lang === 'en' }]}
        aria-current={lang === 'en' ? 'true' : undefined}>English</a>
      <a href={homePath('es')} hreflang="es" lang="es" class:list={['lang-opt', { active: lang === 'es' }]}
        aria-current={lang === 'es' ? 'true' : undefined}>Español</a>
    </div>
  </div>
</aside>

<style>
  .scrim {
    position: fixed;
    inset: 0;
    z-index: 45;
    background: rgba(29, 31, 32, 0.5);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .scrim.open {
    opacity: 1;
    pointer-events: auto;
  }

  .drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 50;
    width: min(340px, 86vw);
    background: var(--color-bg);
    border-left: 1px solid var(--color-divider);
    box-shadow: var(--shadow-lg);
    transform: translateX(102%);
    transition: transform 0.34s cubic-bezier(0.2, 0.7, 0.3, 1);
    display: flex;
    flex-direction: column;
  }
  .drawer.open { transform: translateX(0); }

  .kicker {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-text) 55%, transparent);
  }

  .drawer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 24px;
    height: var(--header-h);
    border-bottom: 1px solid var(--color-divider);
  }
  .close {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid var(--color-divider);
    border-radius: 0;
    cursor: pointer;
    color: var(--color-text);
  }

  .drawer-nav {
    display: flex;
    flex-direction: column;
    padding: 10px 0;
  }
  .drawer-link {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 18px 24px;
    border-bottom: 1px solid var(--color-divider);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 28px;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--color-text);
    text-decoration: none;
  }
  .drawer-link:hover { color: var(--color-text); text-decoration: none; }
  .idx {
    font-family: var(--font-body);
    font-size: 12px;
    letter-spacing: 0.1em;
    color: var(--color-accent-800);
  }

  .drawer-foot {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .lang-box {
    display: flex;
    border: 1px solid var(--color-divider);
    align-self: flex-start;
  }
  .lang-opt {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.1em;
    color: var(--color-text);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 7px 16px;
    background: transparent;
  }
  .lang-opt:hover { text-decoration: none; color: var(--color-text); }
  .lang-opt.active { background: var(--color-accent); color: var(--color-text); }
</style>
