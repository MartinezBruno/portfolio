---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { skills } from '../data/projects';
import SectionHeader from './SectionHeader.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<section id="about" class="about">
  <SectionHeader index="01" title={t('about.title')} />

  <div class="about-grid" data-about-grid>
    <div class="prose" data-reveal>
      <p class="p1">{t('about.p1')}</p>
      <p class="p2">{t('about.p2')}</p>
    </div>

    <div class="tools blueprint" data-reveal>
      <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
      <div class="tools-label">{t('about.toolsTitle')}</div>
      <div class="chips">
        {skills.map((s) => <span class="tag tag-outline chip">{s}</span>)}
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    max-width: 1200px;
    margin: 0 auto;
    padding: 110px 24px 0;
  }
  .about-grid {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 56px;
  }

  /* Reading measure: 30em keeps both paragraphs near 65-75 characters per
     line in either language, in the desktop column and once the grid stacks. */
  .p1 {
    max-width: 30em;
    font-size: 19px;
    line-height: 1.65;
    margin: 0 0 20px;
  }
  .p2 {
    max-width: 30em;
    font-size: 17px;
    line-height: 1.65;
    margin: 0;
    color: color-mix(in srgb, var(--color-text) 74%, transparent);
  }

  .tools { padding: 26px; }
  .tools-label {
    font-family: var(--font-heading);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-text) 55%, transparent);
    margin-bottom: 16px;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chip {
    font-family: var(--font-heading);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
