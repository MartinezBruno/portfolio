---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<div class="spec-strip" data-spec-strip>
  <div class="cell">
    <div class="label">{t('spec.roleK')}</div>
    <div class="value">{t('spec.roleV')}</div>
  </div>
  <div class="cell">
    <div class="label">{t('spec.focusK')}</div>
    <div class="value">{t('spec.focusV')}</div>
  </div>
  <div class="cell">
    <div class="label">{t('spec.stackK')}</div>
    <div class="value">{t('spec.stackV')}</div>
  </div>
  <div class="cell">
    <div class="label">{t('spec.statusK')}</div>
    <div class="value status"><span class="dot" aria-hidden="true"></span>{t('spec.statusV')}</div>
  </div>
</div>

<style>
  .spec-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--color-divider);
    margin-top: clamp(36px, 6vw, 64px);
  }
  .cell {
    padding: 20px 22px;
    border-right: 1px solid var(--color-divider);
  }
  .cell:last-child { border-right: 0; }

  .label {
    font-family: var(--font-heading);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-text) 55%, transparent);
    margin-bottom: 6px;
  }
  .value {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 20px;
    line-height: 1.2;
    text-transform: uppercase;
  }
  .value.status {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--color-accent-800);
  }
  .dot {
    width: 8px;
    height: 8px;
    background: var(--color-accent);
    flex: none;
  }

  @media (max-width: 900px) {
    .spec-strip { grid-template-columns: 1fr 1fr; }
    .cell:nth-child(2) { border-right: 0; }
    .cell:nth-child(1),
    .cell:nth-child(2) { border-bottom: 1px solid var(--color-divider); }
  }
  /* Phones: the title block becomes a four-row key/value table (label left,
     value right) so it takes a third of the height of four stacked cells. */
  @media (max-width: 520px) {
    .spec-strip { grid-template-columns: 1fr; }
    .cell {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 14px 16px;
      border-right: 0;
      border-bottom: 1px solid var(--color-divider);
    }
    .cell:last-child { border-bottom: 0; }
    .label { margin-bottom: 0; }
    .value { text-align: right; }
  }
</style>
