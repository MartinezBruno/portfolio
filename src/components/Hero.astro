---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import SpecStrip from './SpecStrip.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<section class="hero" aria-label="Bruno Martinez">
  <div class="hero-grid" data-hero-grid>
    <div class="hero-copy-col">
      <h1 class="h1" data-h1>
        <span class="mask"><span class="line" data-hero-line>Bruno</span></span>
        <span class="mask"><span class="line" data-hero-line>Martinez</span></span>
      </h1>
      <p class="role" data-hero-copy>{t('hero.role')}</p>
      <p class="blurb" data-hero-copy>{t('hero.blurb')}</p>
      <div class="cta-row" data-hero-copy>
        <a class="btn btn-primary blueprint cta" href="#contact">
          <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
          {t('hero.ctaHire')}
        </a>
        <a class="btn btn-secondary cta" href="#projects">{t('hero.ctaWork')}</a>
      </div>
    </div>

    <figure class="figure">
      <div class="fig-frame blueprint" data-hero-fig>
        <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
        <div class="fig-box">
          <img src="/images/hero-portrait.png" alt="Bruno Martinez" width="800" height="1000" />
        </div>
      </div>
      <figcaption class="figcap">
        <span>FIG. 01 — B. Martinez</span><span>{t('hero.figScale')}</span>
      </figcaption>
    </figure>
  </div>

  <SpecStrip lang={lang} />
</section>

<style>
  .hero {
    max-width: 1200px;
    margin: 0 auto;
    padding: 84px 24px 0;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: 56px;
    align-items: start;
  }

  .h1 {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 92px;
    line-height: 0.92;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    margin: 0 0 20px;
  }
  .mask { display: block; overflow: hidden; }
  .line { display: block; }

  .role {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 24px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-accent-800);
    margin: 0 0 20px;
  }
  .blurb {
    font-size: 17px;
    line-height: 1.6;
    max-width: 46ch;
    margin: 0 0 30px;
    color: color-mix(in srgb, var(--color-text) 78%, transparent);
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .cta {
    padding: 12px 22px;
    font-size: 15px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .figure { margin: 0; }
  .fig-frame {
    padding: 10px;
    background: transparent;
  }
  .fig-box {
    aspect-ratio: 4 / 5;
    position: relative;
    overflow: hidden;
  }
  .fig-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .figcap {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-heading);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 12px;
    margin-top: 10px;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .figure { max-width: 320px; }
    .h1 { font-size: 58px; }
  }
  @media (max-width: 520px) {
    .h1 { font-size: 46px; }
  }
</style>
