---
import type { Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";
import { Picture } from "astro:assets";
import SpecStrip from "./SpecStrip.astro";
import portrait from "../assets/images/hero-portrait.jpg";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="hero" aria-label="Bruno Martinez">
  <div class="hero-grid" data-hero-grid>
    <div class="hero-copy-col">
      <h1 class="h1" data-h1>
        <span class="mask"><span class="line" data-hero-line>Bruno</span></span>
        <span class="mask"
          ><span class="line" data-hero-line>Martinez</span></span
        >
      </h1>
      <p class="role" data-hero-copy>{t("hero.role")}</p>
      <p class="blurb" data-hero-copy>{t("hero.blurb")}</p>
      <div class="cta-row" data-hero-copy>
        <a class="btn btn-primary blueprint cta" href="#contact">
          <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"
          ></i><i class="corner br"></i>
          {t("hero.ctaHire")}
        </a>
        <a class="btn btn-secondary cta" href="#projects">{t("hero.ctaWork")}</a
        >
      </div>
    </div>

    <figure class="figure">
      <div class="fig-frame blueprint" data-hero-fig>
        <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"
        ></i><i class="corner br"></i>
        <div class="fig-box">
          <!-- LCP element: eager, high priority, cropped to the frame's 4:5
               at build time (the same centre crop object-fit showed). -->
          <Picture
            src={portrait}
            alt={t("hero.portraitAlt")}
            formats={["avif", "webp"]}
            width={640}
            height={800}
            fit="cover"
            widths={[320, 480, 640]}
            sizes="(max-width: 560px) calc(100vw - 70px), min(36vw, 444px)"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
      <figcaption class="figcap">
        <span>FIG. 01 — B. Martinez</span><span>{t("hero.figScale")}</span>
      </figcaption>
    </figure>
  </div>

  <SpecStrip lang={lang} />
</section>

<style>
  .hero {
    max-width: 1200px;
    margin: 0 auto;
    padding: 48px 24px 0;
  }
  @media (width >= 768px) {
    .hero {
      padding: 72px 24px 0;
    }
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: clamp(24px, 4.5vw, 56px);
    align-items: start;
  }

  .h1 {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(44px, 8.6vw, 96px);
    line-height: 0.92;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    margin: 0 0 clamp(12px, 1.6vw, 20px);
  }
  .mask {
    display: block;
    overflow: hidden;
  }
  .line {
    display: block;
  }

  .role {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(19px, 2.4vw, 24px);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-accent-800);
    margin: 0 0 clamp(12px, 1.6vw, 20px);
  }
  .blurb {
    font-size: clamp(15px, 1.5vw, 17px);
    line-height: 1.6;
    max-width: min(46ch, 100%);
    margin: 0 0 clamp(20px, 2.6vw, 30px);
    color: color-mix(in srgb, var(--color-text) 78%, transparent);
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .cta {
    padding: 12px 22px;
    font-size: 15px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .figure {
    margin: 0;
  }
  .fig-frame {
    padding: 10px;
    background: transparent;
  }
  .fig-box {
    aspect-ratio: 4 / 5;
    position: relative;
    overflow: hidden;
  }
  .fig-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .figcap {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    font-family: var(--font-heading);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 12px;
    margin-top: 10px;
  }

  @media (max-width: 560px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .figure {
      max-width: 100%;
    }
    .cta {
      flex: 1 1 auto;
      text-align: center;
    }
  }
</style>
