---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  lang: Lang;
}
const { project, lang } = Astro.props;
const t = useTranslations(lang);
const hasImage = project.img.length > 0;
---
<article class="card blueprint" data-reveal>
  <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>

  {hasImage ? (
    <div class="img-box">
      <img src={project.img} alt={project.title} width="640" height="400" loading="lazy" />
    </div>
  ) : (
    <div class="placeholder">
      <span class="ph-label">{t('projects.imagePending')}</span>
    </div>
  )}

  <div class="title-row">
    <span class="p-idx">{project.n}</span>
    <h3 class="h3">{project.title}</h3>
  </div>

  <p class="desc">{project.desc[lang]}</p>

  <div class="stack">
    {project.stack.map((s) => <span class="tag tag-accent chip">{s}</span>)}
  </div>

  <div class="btn-row">
    <a class="btn btn-primary act" href={project.live}>{t('projects.viewPage')}</a>
    <a class="btn btn-secondary act" href={project.code}>{t('projects.viewCode')}</a>
  </div>
</article>

<style>
  .card {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .img-box {
    aspect-ratio: 16 / 10;
    border: 1px solid var(--color-divider);
    overflow: hidden;
  }
  .img-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }

  .placeholder {
    aspect-ratio: 16 / 10;
    border: 1px solid var(--color-divider);
    display: flex;
    align-items: center;
    justify-content: center;
    background: repeating-linear-gradient(
      135deg,
      transparent 0 9px,
      color-mix(in srgb, var(--color-text) 7%, transparent) 9px 10px
    );
  }
  .ph-label {
    font-family: var(--font-heading);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-text) 55%, transparent);
    background: var(--color-bg);
    padding: 6px 10px;
  }

  .title-row {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .p-idx {
    font-family: var(--font-heading);
    font-size: 12px;
    letter-spacing: 0.16em;
    color: var(--color-accent-800);
  }
  .h3 {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 30px;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    margin: 0;
  }

  .desc {
    font-size: 15px;
    line-height: 1.6;
    margin: 0;
    color: color-mix(in srgb, var(--color-text) 76%, transparent);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .chip {
    font-family: var(--font-heading);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .btn-row {
    display: flex;
    gap: 10px;
    margin-top: auto;
    padding-top: 4px;
  }
  .act {
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
</style>
